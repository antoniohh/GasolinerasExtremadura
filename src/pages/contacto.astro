---
import BaseLayout from "../layouts/BaseLayout.astro";
import { Mail, ArrowLeft, ExternalLink, CodeXml, ShieldAlert, Globe, MessageSquare } from "@lucide/astro";
import { withBase, SITE_DOMAIN, SITE_NAME, AUTHOR_NAME, AUTHOR_URL, AUTHOR_EMAIL, GITHUB_URL } from "../lib/site";
---

<BaseLayout
  title={`Contacto y Soporte | ${SITE_NAME}`}
  description={`Canales de contacto directo con el responsable de ${SITE_NAME} (${SITE_DOMAIN}), soporte técnico en GitHub y orientación al consumidor de carburantes en Extremadura.`}
  canonicalPath="contacto/"
>
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-12 sm:py-16">
    <div class="flex flex-wrap items-center justify-between gap-4 mb-8">
      <a
        href={withBase()}
        class="inline-flex items-center gap-1.5 text-xs sm:text-sm font-semibold text-slate-600 hover:text-sky-700 transition-colors"
      >
        <ArrowLeft size={16} />
        <span>Volver a la portada</span>
      </a>

      <!-- Navegación rápida entre páginas legales y contacto -->
      <nav aria-label="Documentación legal y contacto" class="flex flex-wrap items-center gap-2 text-xs font-semibold">
        <a
          href={withBase("aviso-legal/")}
          class="px-3 py-1.5 rounded-lg bg-slate-200/80 text-slate-700 hover:bg-slate-300 transition-colors"
        >
          Aviso legal
        </a>
        <a
          href={withBase("privacidad/")}
          class="px-3 py-1.5 rounded-lg bg-slate-200/80 text-slate-700 hover:bg-slate-300 transition-colors"
        >
          Política de privacidad
        </a>
        <a
          href={withBase("cookies/")}
          class="px-3 py-1.5 rounded-lg bg-slate-200/80 text-slate-700 hover:bg-slate-300 transition-colors"
        >
          Política de cookies
        </a>
        <span class="px-3 py-1.5 rounded-lg bg-slate-900 text-sky-300">
          Contacto
        </span>
      </nav>
    </div>

    <header class="mb-10 pb-6 border-b border-slate-200">
      <div class="flex items-center gap-2.5 text-sky-700 font-bold text-sm uppercase tracking-wider mb-2">
        <Mail size={20} />
        <span>Atención al Usuario y Comunicación Directa</span>
      </div>
      <h1 class="text-3xl sm:text-4xl font-extrabold text-slate-900 tracking-tight">
        Contacto y Soporte
      </h1>
      <p class="mt-3 text-base sm:text-lg text-slate-600">
        Vías directas de comunicación con el titular de <strong>{SITE_NAME} ({SITE_DOMAIN})</strong> para consultas sobre la herramienta, sugerencias de mejora, incidencias técnicas o cuestiones legales.
      </p>
    </header>

    <div class="space-y-8 text-slate-700 text-sm sm:text-base leading-relaxed">
      <!-- Tarjetas de Canales Directos -->
      <section class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <!-- Canal 1: Contacto con el Autor / Titular -->
        <div class="bg-white border border-slate-200 rounded-2xl p-6 shadow-xs flex flex-col justify-between">
          <div>
            <div class="w-11 h-11 rounded-xl bg-sky-50 border border-sky-200 text-sky-700 flex items-center justify-center mb-4">
              <Globe size={22} />
            </div>
            <h2 class="text-lg font-extrabold text-slate-900 mb-2">
              Contacto con el titular ({AUTHOR_NAME})
            </h2>
            <p class="text-sm text-slate-600 leading-relaxed">
              Para consultas generales, propuestas de colaboración, prensa o comunicaciones legales relacionadas con el dominio <strong>{SITE_DOMAIN}</strong> y el ejercicio de derechos RGPD / LSSI-CE.
            </p>
            <p class="mt-3 text-sm text-slate-700">
              <strong>Correo electrónico directo:</strong>{" "}
              <a
                href={`mailto:${AUTHOR_EMAIL}`}
                class="font-bold text-sky-800 hover:underline"
              >
                {AUTHOR_EMAIL}
              </a>
            </p>
          </div>
          <div class="mt-5 pt-4 border-t border-slate-100 flex flex-wrap items-center gap-2.5">
            <a
              href={`mailto:${AUTHOR_EMAIL}`}
              class="inline-flex items-center gap-2 px-4 py-2.5 rounded-xl bg-slate-900 hover:bg-slate-800 text-sky-300 font-bold text-xs sm:text-sm transition-colors"
            >
              <Mail size={15} />
              <span>Escribir correo</span>
            </a>
            <a
              href={AUTHOR_URL}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 px-4 py-2.5 rounded-xl bg-slate-100 hover:bg-slate-200 text-slate-800 font-bold text-xs sm:text-sm transition-colors"
            >
              <span>Web del autor</span>
              <ExternalLink size={15} />
            </a>
          </div>
        </div>

        <!-- Canal 2: Soporte Técnico y Sugerencias -->
        <div class="bg-white border border-slate-200 rounded-2xl p-6 shadow-xs flex flex-col justify-between">
          <div>
            <div class="w-11 h-11 rounded-xl bg-emerald-50 border border-emerald-200 text-emerald-700 flex items-center justify-center mb-4">
              <CodeXml size={22} />
            </div>
            <h2 class="text-lg font-extrabold text-slate-900 mb-2">
              Incidencias técnicas y mejoras
            </h2>
            <p class="text-sm text-slate-600 leading-relaxed">
              ¿Has detectado algún error visual en tu móvil, tienes una idea para el buscador de municipios o quieres revisar el código fuente? Puedes abrir un ticket público en nuestro repositorio oficial.
            </p>
          </div>
          <div class="mt-5 pt-4 border-t border-slate-100">
            <a
              href={`${GITHUB_URL}/issues`}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 px-4 py-2.5 rounded-xl bg-emerald-700 hover:bg-emerald-600 text-white font-bold text-xs sm:text-sm transition-colors"
            >
              <span>Abrir incidencia en GitHub</span>
              <ExternalLink size={15} />
            </a>
          </div>
        </div>
      </section>

      <!-- Aviso Importante: No somos una gasolinera ni operadora petrolífera -->
      <section class="bg-sky-50/80 border border-sky-200 rounded-2xl p-6 sm:p-8">
        <div class="flex items-start gap-3.5">
          <div class="w-10 h-10 rounded-xl bg-sky-100 text-sky-800 flex items-center justify-center shrink-0 mt-0.5">
            <ShieldAlert size={22} />
          </div>
          <div>
            <h2 class="text-lg sm:text-xl font-extrabold text-slate-900 mb-2">
              Importante: ¿Tienes una consulta o reclamación sobre un repostaje, ticket o estación de servicio?
            </h2>
            <p class="text-sm sm:text-base text-slate-700">
              <strong>{SITE_NAME} ({SITE_DOMAIN}) es un portal informativo independiente</strong> y no una estación de servicio, distribuidora ni operadora petrolífera. No vendemos carburante, no emitimos tickets ni facturas y no gestionamos pagos ni tarjetas de fidelización.
            </p>
            <p class="mt-3 text-sm text-slate-700">
              Si necesitas solicitar una factura de repostaje, reclamar una discrepancia entre el precio anunciado y el cobrado en el surtidor o presentar una hoja de reclamaciones en las provincias de Badajoz o Cáceres, debes dirigirte directamente a la <strong>estación de servicio titular</strong> o bien a los organismos oficiales competentes:
            </p>
            <ul class="list-disc pl-5 mt-3 space-y-1.5 text-xs sm:text-sm text-slate-700">
              <li>
                <strong>Geoportal Oficial de Gasolineras (MITECO):</strong> Consulta oficial del censo y precios comunicados por las estaciones de servicio conforme a la Orden ITC/2308/2007 (<a href="https://geoportalgasolineras.es/" target="_blank" rel="noopener noreferrer" class="font-semibold text-sky-900 underline">geoportalgasolineras.es</a>).
              </li>
              <li>
                <strong>Instituto de Consumo de Extremadura (INCOEX):</strong> Atención, arbitraje y reclamaciones de personas consumidoras en la Junta de Extremadura (<a href="https://saludextremadura.ses.es/incoex/" target="_blank" rel="noopener noreferrer" class="font-semibold text-sky-900 underline">saludextremadura.ses.es/incoex</a>).
              </li>
              <li>
                <strong>Comisión Nacional de los Mercados y la Competencia (CNMC):</strong> Supervisión e informes del mercado de distribución de carburantes en España (<a href="https://www.cnmc.es/" target="_blank" rel="noopener noreferrer" class="font-semibold text-sky-900 underline">cnmc.es</a>).
              </li>
            </ul>
          </div>
        </div>
      </section>

      <!-- Privacidad en las comunicaciones -->
      <section class="bg-white border border-slate-200 rounded-2xl p-6 sm:p-8 shadow-xs">
        <div class="flex items-center gap-2.5 mb-3">
          <MessageSquare size={20} class="text-slate-700" />
          <h2 class="text-lg sm:text-xl font-bold text-slate-900">
            Privacidad en tus comunicaciones
          </h2>
        </div>
        <p class="text-sm sm:text-base text-slate-600">
          Para garantizar tu máxima privacidad y evitar almacenar datos personales innecesarios en servidores intermedios, <strong>{SITE_DOMAIN}</strong> no incluye formularios web que guarden tus datos en bases de datos propias. Cualquier comunicación realizada con el titular se atenderá exclusivamente con la finalidad de responder a tu consulta, sin incorporar tu dirección ni tus datos a listas comerciales ni cederlos a terceros, conforme a nuestra{" "}
          <a href={withBase("privacidad/")} class="font-bold text-sky-800 hover:underline">
            Política de Privacidad
          </a>.
        </p>
      </section>
    </div>
  </div>
</BaseLayout>
